  "processing": {
    "append_with_provenance": true,
    "join_across_sources": false,
    "preserve_id_strings": true,
    "require_compatible_types_units_and_business_meaning": true,
    "unverified_mapping": "review"
  },
  "fixture": {
    "generator": "scripts/generate_synthetic.py",
    "seed": 20261027,
    "records_per_source": 60,
    "record_count_total": 180
  }
}
